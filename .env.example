# Variables de BUILD (se leen al ejecutar `npm run build`).
# En Cloudflare: Workers & Pages > tu Worker > Settings > Build > Variables and secrets.

# URL pública del sitio (canonical, sitemap, og:url). Sin barra final.
SITE_URL=https://lorenagall.lorena.workers.dev

# true  = noindex (meta robots + X-Robots-Tag + robots.txt Disallow: /)
# false = indexable. Poner false SOLO al migrar el dominio definitivo.
NOINDEX=true

# Clave pública de Cloudflare Turnstile (para pruebas locales: 1x00000000000000000000AA)
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Token de Cloudflare Web Analytics (opcional; si falta no se carga el beacon)
PUBLIC_CF_ANALYTICS_TOKEN=
