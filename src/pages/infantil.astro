---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Descargas from '../components/Descargas.astro';
import Share from '../components/Share.astro';
import { infantiles, infantilIntro } from '../data/libros';
import { LICENSE } from '../data/site';
import { abs, bookLd, ogImage } from '../lib/seo';
import foto1 from '../assets/infantil/trabajo-en-familia-1.jpg';
import foto2 from '../assets/infantil/trabajo-en-familia-2.jpg';

const description = 'Trabajo en familia es un proyecto de creación conjunta de libros para chicos entre una mamá que escribe y una hija que dibuja.';
const altFoto = 'Lorena Gall con una niña, ambas sonriendo, frente a un fondo de vegetación';
const ld = await Promise.all(
  infantiles.map(async (l) =>
    bookLd({ ...l, path: `/infantil/#${l.anchor}`, imageUrl: (await ogImage(l.imagenes[0].src, l.imagenes[0].alt)).url, illustrator: 'Genoveva Lojo Gall' }),
  ),
);
---
<Base title="Infantil - Lorena Gall" description={description} type="article" image={{ src: foto1, alt: altFoto }} jsonLd={ld}>
  <div class="wrap page">
    <h1 class="center">{infantilIntro.titulo}</h1>
    <ul class="index-links">
      {infantiles.map((l) => <li><a href={`#${l.anchor}`}><Icon name="book" />{l.titulo === 'El Dragón Sin Fuego' ? 'El dragón sin fuego' : l.titulo}</a></li>)}
    </ul>
    <hr class="rule" />

    <figure class="family">
      <div class="family-photos">
        <Image src={foto1} alt={altFoto} widths={[400, 500, 800]} sizes="(min-width: 40rem) 45vw, 92vw" loading="eager" />
        <Image src={foto2} alt="Lorena Gall y una niña sonriendo, mirándose, frente a un fondo de vegetación" widths={[400, 500, 800]} sizes="(min-width: 40rem) 45vw, 92vw" loading="lazy" />
      </div>
      <figcaption>Foto: Federico Gall</figcaption>
    </figure>

    <div class="family-text">
      {infantilIntro.parrafos.map((p) => <p set:html={p} />)}
    </div>
    <hr class="rule" />

    {infantiles.map((l) => {
      const label = l.titulo === 'El Dragón Sin Fuego' ? 'El dragón sin fuego' : l.titulo;
      return (
        <section class="kid-book" id={l.anchor} aria-labelledby={`t-${l.anchor}`}>
          <h2 id={`t-${l.anchor}`}>{l.titulo}</h2>
          {l.imagenes.length === 2 ? (
            <div class="flip" role="group" aria-label={`Tapa y contratapa de ${label}. Con el mouse, pasá el cursor por encima para ver la contratapa.`}>
              <div class="flip-inner">
                <Image class="flip-face flip-front" src={l.imagenes[0].src} alt={l.imagenes[0].alt} widths={[480, 640, 670]} sizes="(min-width: 40rem) 40rem, 92vw" loading="lazy" />
                <Image class="flip-face flip-back" src={l.imagenes[1].src} alt={l.imagenes[1].alt} widths={[480, 640, 670]} sizes="(min-width: 40rem) 40rem, 92vw" loading="lazy" />
              </div>
              <p class="flip-hint" aria-hidden="true">Pasá el mouse para ver la contratapa</p>
            </div>
          ) : (
            <div class="kid-covers kid-covers--one">
              {l.imagenes.map((img) => (
                <Image src={img.src} alt={img.alt} widths={[480, 640, 800]} sizes="(min-width: 40rem) 40rem, 92vw" loading="lazy" />
              ))}
            </div>
          )}
          <div class="downloads">
            <h3>Descargá aquí el libro</h3>
            <Descargas titulo={label} descargas={l.descargas} />
          </div>
          <Share url={abs(`/infantil/#${l.anchor}`)} title={`${label}, de Lorena Gall`} />
        </section>
      );
    })}
  </div>
  <p class="license">
    Estas obras están bajo una <a rel="license noopener" href={LICENSE.href} target="_blank">Licencia {LICENSE.name}</a>.
  </p>
</Base>

<script>
  // El flip se activa solo con mouse (hover + puntero fino). En ese caso la tarjeta pasa a ser
  // enfocable con teclado (Tab) para poder ver la contratapa; en táctil no hay parada de Tab extra.
  const mq = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 40rem)');
  const cards = document.querySelectorAll<HTMLElement>('.flip');
  const sync = () => cards.forEach((c) => (mq.matches ? c.setAttribute('tabindex', '0') : c.removeAttribute('tabindex')));
  sync();
  mq.addEventListener('change', sync);
</script>
