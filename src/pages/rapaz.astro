---
import Base from '../layouts/Base.astro';
import LibroFicha from '../components/LibroFicha.astro';
import { rapaz } from '../data/libros';
import { bookLd, ogImage } from '../lib/seo';

const path = Astro.url.pathname;
const description = 'Rapaz, la primera novela de Lorena Gall, cuenta la relación entre Magdalena, una odontóloga de 39 años, y Ezequiel, un albañil de 22.';
const img = rapaz.imagenes[0];
const og = await ogImage(img.src, img.alt);
---
<Base
  title="Rapaz - Lorena Gall"
  description={description}
  type="article"
  image={img}
  jsonLd={[bookLd({ ...rapaz, path, imageUrl: og.url, description })]}
>
  <LibroFicha libro={rapaz} />
</Base>
